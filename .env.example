# fxapk 在线富化所需的 API key（本文件是模板，可入库；真实密钥写进 .env，.env 已 gitignore）。
# 用法：cp .env.example .env，把真实 key 填到对应行。**全部可选**——不填只缺对应富化能力，核心分析不受影响。
# 默认只读取第三方已扫库 / 公开登记；不会主动访问样本声明的业务 URL，但 DNS 查询仍可能被递归解析器和权威 DNS 观察到。

# ── apkscan 主项目直接使用 ──────────────────────────────────────────────

# HAPI —— 域名 ICP 备案自动初筛；结果属于第三方富化，重要主体仍须到工信部人工核验。
# 申请：https://api.8450.cn/ （Token 仅走 Authorization header，不拼入 URL）。
FXAPK_ICP_HAPI_KEY=

# Shodan —— 海外服务器**被动 IP 归属**取证：读 Shodan 已扫库（开放端口 / 服务 banner /
# 产品版本 / 归属 ASN·org·归属国 / 关联主机名），仅作为 CDN/边缘与承载候选画像，不能单独确认
# 真实 Origin 或并案关系。查询会向 Shodan 披露目标并消耗账户额度；普通 analyze 不调用，仅
# case close 的有界目标集或受硬顶保护、先 dry-run 预算的 enrich batch 才会调用。
# 申请：https://account.shodan.io/  （注册后 Account 页可见 API Key）
FXAPK_SHODAN_KEY=

# ── 扩展富化源（IP / 域名深度归属 · 串案用；由多源富化工具按需拉取）────────────
#  apkscan analyze 会按端点类型有界调用已配置的 HAPI，但不会调用 Shodan；fxapk case close
#  会对其有界目标集调用 Shodan 及下列已配置的被动情报 / 网络空间测绘服务。enrich batch 也会
#  调用这些来源，但单轮目标数有不可绕过的硬顶。全部可选，不配置会在来源状态中明确记为 disabled。
#  DayDayMap 已由核心统一调用并写逐源回执；enrich inventory 零联网盘点，配置不等于已查询。

# FOFA（白帽汇）—— 网络空间测绘：按 IP / 证书 / 指纹反查同源资产、常捞到 DoH 看不到的历史落地 IP。
# 申请：https://fofa.info/  （注册后 个人中心 → API Key）
FXAPK_FOFA_KEY=
# FXAPK_FOFA_URL=            # 可选：HTTPS 根地址或完整 /api/v1/search/all；默认官方

# 360 Quake —— 国内网络空间测绘（同 FOFA 类，境内资产覆盖好）。
# 申请：https://quake.360.net/  （注册后 个人中心 → API Token）
FXAPK_QUAKE_KEY=
# FXAPK_QUAKE_KEY2=          # 可选：主 Token 未配置时使用；batch --credential-slot 2 可明确选择
# FXAPK_QUAKE_URL=           # 可选：HTTPS 根地址或完整 /api/v3/search/quake_service

# 奇安信 Hunter（鹰图）—— ★境内最有用：返 ICP 备案 company + as_org + 机房城市，最利于境内定人。
# 申请：https://hunter.qianxin.com/  （注册后 个人中心 → API）。★须**境内直连**（走代理常 403）。
FXAPK_HUNTER_KEY=

# DayDayMap（核心和配套工具均有适配）—— 与 Hunter 交叉核验：
# ICP 备案主体 + ASN/机房 + 同机域名。
# 申请：https://www.daydaymap.com/  （注册后 个人中心 → API）。经代理可达，无须境内直连。
# ★接口 POST，keyword 须**标准 base64**，API-KEY 走请求头；返回字段由 fields 显式声明决定。
# ★注意语义：IP 维度返回的备案主体是**同 IP 各站点**的，与该 IP 持有人无关（共享/云 IP 尤甚）；
#   只有域名维度才是该域名自身的备案主体。别把前者当成"这个 IP 归谁"。
# 核心选择首个已配置凭据；batch --credential-slot 1/2 明确选账户，不因限频自动轮换。
FXAPK_DAYDAYMAP_KEY=
FXAPK_DAYDAYMAP_KEY2=

# ZoomEye —— 网络空间测绘，补充主机端口、产品和 ASN/地理信息。
# 申请：https://www.zoomeye.org/  （注册后获取 API Key）
FXAPK_ZOOMEYE_KEY=
# FXAPK_ZOOMEYE_URL=         # 可选：HTTPS 根地址或完整 /v2/search；核心使用 POST v2

# Censys —— 主机、服务与自治系统被动测绘。
# 申请：https://search.censys.io/account/api  （使用 Platform API Token）
FXAPK_CENSYS_TOKEN=
# FXAPK_CENSYS_ORG_ID=       # 可选：组织 ID

# VirusTotal —— 域名 / IP / 文件威胁情报 + 历史解析（passive DNS）。
# 申请：https://www.virustotal.com/gui/join-us  （注册后 → API Key）
FXAPK_VT_KEY=

# AlienVault OTX —— 开放威胁情报 pulse + passive DNS。
# 申请：https://otx.alienvault.com/  （注册后 Settings → OTX Key）
FXAPK_OTX_KEY=

# urlscan.io —— URL 扫描历史 + 关联资源 / 截图。
# 申请：https://urlscan.io/user/signup/  （注册后 Settings → API Key）
FXAPK_URLSCAN_KEY=

# AbuseIPDB —— IP 滥用举报信誉（是否已被标记恶意）。
# 申请：https://www.abuseipdb.com/register  （注册后 Account → API）
FXAPK_ABUSEIPDB_KEY=

# 以下产品需先核账户权限，再在 batch 的 --providers 中显式选择；不沿用历史月份配额状态。
# ThreatBook IP Reputation: --stage api --providers threatbook
FXAPK_THREATBOOK_KEY=
# WhoisXML DNS Chronicle（不是其全部产品）: --stage api --providers whoisxml
FXAPK_WHOISXML_KEY=
# NGHIMMO_API_KEY 未知用途，当前无适配；不要向猜测的服务地址提交。
