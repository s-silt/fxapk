#!/bin/sh
# 提交前泄漏扫描 —— 拦住一类**不可撤销**的错误：真实地址 / 凭据一旦推上远端，
# 改写历史也删不掉缓存副本，唯一可靠的办法是源头不写进去。
#
# 安装（clone 后跑一次）：
#     git config core.hooksPath .githooks
#
# 判据只看**已 staged 的新增行**。默认阻断 ip / secret / exemption 三条（精确、误报可控）；
# domain / context 如实报告但不变红。要连它们一起阻断：
#     FXAPK_LEAK_SCAN_STRICT=1 git commit ...
#
# 放行某行：行内加 `leak-scan: allow <理由>`（理由必须写）。
# 本 hook 是本地第一道；CI 对 PR diff 再扫一遍，故 --no-verify 绕不过最终门禁。

set -e

if ! command -v python >/dev/null 2>&1; then
    echo "leak-scan: 找不到 python，跳过扫描（CI 仍会扫 PR diff）。" >&2
    exit 0
fi

# 包不可导入（未 pip install -e .）时跳过而非拒绝提交：hook 不该把环境问题变成提交障碍。
if ! python -c "import apkscan.core.leakscan" >/dev/null 2>&1; then
    echo "leak-scan: apkscan 不可导入（先 pip install -e .），跳过扫描（CI 仍会扫 PR diff）。" >&2
    exit 0
fi

if [ -n "$FXAPK_LEAK_SCAN_STRICT" ]; then
    exec python -m apkscan.cli leak-scan --staged --strict
fi
exec python -m apkscan.cli leak-scan --staged
